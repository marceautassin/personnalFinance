# ── Fournisseur LLM ──────────────────────────────────────────────────────────
# Ne JAMAIS commit la vraie clé. Copier ce fichier en .env et y mettre la valeur réelle.

# Mistral — cible depuis le 2026-09-04 (D20, modèle `zai-glm-5-2`, inférence Europe).
# La clé peut être renseignée dès maintenant : elle ne sera consommée qu'à la story 13-5.
MISTRAL_API_KEY=

# Anthropic — fournisseur actuel, encore utilisé par `llm-categorizer.ts`.
# Reste requis jusqu'à la bascule (story 13-5), qui le retirera.
ANTHROPIC_API_KEY=

# ── Optionnel ────────────────────────────────────────────────────────────────
# Surcharge du chemin de la base SQLite (défaut: ./_data/personnalfinance.db)
# DATABASE_URL=

# Surcharge du dossier de stockage des PDFs (défaut: ./_data/raw)
# PDF_STORAGE_DIR=

# Port du serveur de dev sous test E2E (défaut: 3178)
# E2E_PORT=
