# ── Fournisseur LLM ──────────────────────────────────────────────────────────
# Mistral, inférence en Europe (D20, NFR7).
# Ne JAMAIS commit la vraie clé. Copier ce fichier en .env et y mettre la valeur réelle.
MISTRAL_API_KEY=

# Optionnel — modèle de catégorisation (NFR34). Défaut : `zai-glm-5`, un ALIAS qui suit la
# dernière GLM-5 (5.3 au 2026-09-26). Pour figer une version : `zai-glm-5-3`.
# Tout changement de modèle impose de re-mesurer le taux de correction (jalon, NFR34).
# MISTRAL_CATEGORIZER_MODEL=zai-glm-5

# ── Optionnel ────────────────────────────────────────────────────────────────
# Surcharge du chemin de la base SQLite (défaut: ./_data/personnalfinance.db)
# DATABASE_URL=

# Surcharge du dossier de stockage des PDFs (défaut: ./_data/raw)
# PDF_STORAGE_DIR=

# Port du serveur de dev sous test E2E (défaut: 3178)
# E2E_PORT=
